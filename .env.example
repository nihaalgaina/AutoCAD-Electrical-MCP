# ── AI Provider ───────────────────────────────────────────────────────────────
# Which provider to use by default: claude | ollama | openai | groq | lmstudio
ACTIVE_PROVIDER=ollama

# API keys — only needed for the providers you use
ANTHROPIC_API_KEY=your_anthropic_key_here
OPENAI_API_KEY=your_openai_key_here
GROQ_API_KEY=your_groq_key_here

# ── MCC Block Library ─────────────────────────────────────────────────────────
# Full path to the folder that contains your .DWG block files
# (MCC_400.DWG, UNIT4040.DWG, UDATALIN.DWG, LAMACOID.DWG, etc.)
# Separate multiple folders with a semicolon (;)
MCC_BLOCK_LIBRARY=C:\Path\To\Your\MCC Blocks
